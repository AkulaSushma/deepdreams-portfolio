{
  // Cloudflare Pages project configuration. Mirrors what the dashboard would
  // otherwise hold, so a rebuild from a clean clone keeps the same behaviour:
  // the Functions under functions/ use require("crypto") and other Node
  // built-ins, which need nodejs_compat and a compatibility date of
  // 2024-09-23 or later (bare "crypto" resolves from that date).
  //
  // ⚠️ SOURCE OF TRUTH: because this file contains pages_build_output_dir,
  // Cloudflare treats it as the ONLY source of plain-text (non-secret)
  // settings. Every `wrangler pages deploy` ERASES dashboard-set plain-text
  // variables that are not declared here (encrypted secrets are kept — set
  // those with `wrangler pages secret bulk`). That is why SUPABASE_URL is
  // declared below instead of pasted into the dashboard, and why the four
  // secrets (ADMIN_PASSWORD, ADMIN_SESSION_SECRET, SUPABASE_SERVICE_KEY,
  // TOKEN_PEPPER) live in Cloudflare's encrypted secret store, not here.
  "name": "deepdreams-portfolio",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "vars": {
    "SUPABASE_URL": "https://fthrpomwxatxpztfioqc.supabase.co"
  }
}
